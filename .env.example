# Server
PORT=8848
HOST_PORT=8848
NODE_ENV=production

# Single upstream Anthropic API
DEFAULT_UPSTREAM_URL=https://api.anthropic.com
DEFAULT_API_KEY=

# Optional multi-upstream channels
# UPSTREAMS_JSON=[{"name":"primary","type":"anthropic","baseUrl":"https://api.anthropic.com","apiKey":"sk-ant-..."},{"name":"backup","type":"openai","baseUrl":"https://api.openai.com","apiKey":"sk-...","model":"gpt-4o-mini"}]
# UPSTREAM_URLS=https://api.anthropic.com,https://api.openai.com
# UPSTREAM_API_KEYS=sk-ant-...,sk-...
# UPSTREAM_TYPES=anthropic,openai
# UPSTREAM_MODELS=,gpt-4o-mini

# Thinking defaults
DEFAULT_THINKING_ENABLED=true
DEFAULT_THINKING_BUDGET=5000
